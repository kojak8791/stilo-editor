{
  "name": "stilo-editor",
  "version": "0.2.0",
  "description": "A complete rich text editor. Everything included, ready in minutes. Open-source WYSIWYG HTML editor built on ProseMirror: clean HTML in and out, headless core.",
  "keywords": [
    "wysiwyg",
    "wysiwyg-editor",
    "wysiwyg-html-editor",
    "rich-text",
    "rich-text-editor",
    "richtext",
    "text-editor",
    "html-editor",
    "editor",
    "prosemirror",
    "contenteditable",
    "html5",
    "typescript",
    "headless",
    "framework-agnostic"
  ],
  "author": "Alessio Coggiola <alessio.coggiola@gmail.com>",
  "license": "MIT",
  "homepage": "https://kojak8791.github.io/stilo-editor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kojak8791/stilo-editor.git"
  },
  "bugs": {
    "url": "https://github.com/kojak8791/stilo-editor/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui.js"
    },
    "./content.css": "./dist/content.css",
    "./ui.css": "./dist/ui.css",
    "./style.css": "./dist/style.css"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "site": "vite -c vite.site.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:site": "vite build -c vite.site.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings --max-diagnostics=none .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "playwright test -c playwright.bench.config.ts",
    "size": "npm run build && node scripts/size.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "dompurify": "^3.4.16",
    "lucide": "^1.55.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-search": "^1.1.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
